{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022"],
    "strict": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "noEmit": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "types": ["node", "vitest/globals"],
    "baseUrl": ".",
    "paths": {
      "@api-security-shield/detectors": ["packages/detectors/src/index.ts"],
      "@api-security-shield/rate-limit": ["packages/rate-limit/src/index.ts"],
      "@api-security-shield/redis": ["packages/redis/src/index.ts"],
      "@api-security-shield/reputation": ["packages/reputation/src/index.ts"],
      "@api-security-shield/plugins": ["packages/plugins/src/index.ts"],
      "@api-security-shield/dashboard": ["packages/dashboard/src/index.ts"]
    }
  },
  "include": [
    "src/**/*.ts",
    "packages/**/*.ts",
    "tests/**/*.ts",
    "benchmarks/**/*.ts",
    "scripts/**/*.ts",
    "*.config.ts",
    "eslint.config.mjs"
  ],
  "exclude": ["dist", "coverage", "node_modules", "packages/*/dist"]
}
